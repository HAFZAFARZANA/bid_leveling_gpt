# Copy to .env and add your own secret key. Never expose this key to the frontend.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1
# high is better for dense tables/scanned pages but may use more tokens; options: auto, low, high
OPENAI_PDF_DETAIL=high

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=45
